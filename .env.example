# Copy to .env.local (never commit .env.local)

# --- Public site URL (required for email links & Open Graph) ---
# Use your custom domain in production — avoids Gmail flagging vercel.app links
# Production: https://abdifatah.uk | Local dev can use http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://abdifatah.uk

# --- Google Analytics 4 (track visitors & company utm_source) ---
# https://analytics.google.com → Admin → Data streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Google Search Console verification (optional) ---
NEXT_PUBLIC_GSC_VERIFICATION=

# --- View visit log in production (optional; dev works without) ---
ANALYTICS_VIEW_TOKEN=
ANALYTICS_SALT=change-me-to-random-string

# --- Cloudflare Turnstile (contact form) ---
# Create keys: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional: deliver contact form via Resend ---
# https://resend.com — verify your domain for production "from" address
RESEND_API_KEY=
RESEND_FROM_EMAIL=Portfolio <hello@abdifatah.uk>
CONTACT_NOTIFY_EMAIL=afm.dvx@gmail.com

# --- Admin APIs are dev-only (NODE_ENV=development) ---
# No secrets required for portfolio read-only production deploy
